<?xml version="1.0" encoding="utf-8"?>
<plugin id="cordova-plugin-security-hardening"
        version="1.0.0"
        xmlns="http://apache.org/cordova/ns/plugins"
        xmlns:android="http://schemas.android.com/apk/res/android">

    <name>CertCheck</name>

    <!-- JS bridge -->
    <js-module src="www/certcheck.js" name="CertCheck">
        <clobbers target="CertCheck" />
    </js-module>

    <!-- ANDROID -->
    <platform name="android">
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="CertCheck">
                <param name="android-package" value="com.proint.security.CertCheck" />
            </feature>
        </config-file>

        <source-file src="src/android/CertCheck.java" target-dir="src/com/proint/security" />
    </platform>

    <!-- IOS -->
    <platform name="ios">
        <!-- INI YANG PENTING UNTUK MAPPING DI iOS -->
        <config-file target="config.xml" parent="/*">
            <feature name="CertCheck">
                <param name="ios-package" value="CertCheck" />
            </feature>
        </config-file>

        <source-file src="src/ios/CertCheck.m" />
        <source-file src="src/ios/CertCheck.h" />
    </platform>

</plugin>
